{
  "name": "challenge-cypress",
  "version": "1.0.0",
  "description": "Cypress automation challenge featuring 3 E2E frontend tests and 3 API test scenarios for the ServeRest application, implemented in JavaScript following automation testing best practices.",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:frontend": "cypress run --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:ci": "cypress run"
  },
